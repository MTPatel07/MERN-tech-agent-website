# ==============================================================================
# terraform.tfvars.example
# Copy this file to 'terraform.tfvars' and fill in your values.
# terraform.tfvars is gitignored to protect sensitive configuration.
#
# Usage: cp terraform.tfvars.example terraform.tfvars
# ==============================================================================

# ── General ───────────────────────────────────────────────────────────────────
project_name = "nexus-labs"
environment  = "prod"
aws_region   = "ap-south-1"  # Mumbai (closest to Ahmedabad/Hyderabad)

# ── Networking ────────────────────────────────────────────────────────────────
vpc_cidr             = "10.0.0.0/16"
public_subnet_cidrs  = ["10.0.1.0/24", "10.0.2.0/24"]
private_subnet_cidrs = ["10.0.11.0/24", "10.0.12.0/24"]
availability_zones   = ["ap-south-1a", "ap-south-1b"]

# ── Container Images (from your GitHub Actions CI/CD pipeline) ────────────────
# These are built and pushed by your .github/workflows/cicd.yml
frontend_image = "ghcr.io/mtpatel07/dockerized_web_application-frontend:latest"
backend_image  = "ghcr.io/mtpatel07/dockerized_web_application-backend:latest"

# ── ECS Compute (cost-optimized for Fargate Free Tier) ────────────────────────
frontend_cpu    = 256   # 0.25 vCPU
frontend_memory = 512   # 0.5 GB
backend_cpu     = 256
backend_memory  = 512

frontend_desired_count = 1
backend_desired_count  = 1

# ── Ports ─────────────────────────────────────────────────────────────────────
frontend_port = 80
backend_port  = 5000
